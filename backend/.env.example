# ==============================================================================
# BIẾN MÔI TRƯỜNG BACKEND HOMESTAY (Node.js + Express + Prisma)
# Hướng dẫn: Sao chép file này thành .env và điền thông tin phù hợp với môi trường của bạn.
# LƯU Ý: Tuyệt đối KHÔNG commit file .env chứa mật khẩu thật lên GitHub!
# ==============================================================================

# 1. Chuỗi kết nối cơ sở dữ liệu PostgreSQL (Connection Pooling / Transaction Mode)
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/ptda_staging"

# 2. Chuỗi kết nối trực tiếp PostgreSQL (Direct Connection cho Prisma Migrate & Schema Validation)
# Trong môi trường Local: Đặt giống DATABASE_URL
# Trong môi trường Cloud (Supabase): Dùng directUrl (port 5432) thay cho Pooler (port 6543)
DIRECT_URL="postgresql://postgres:your_postgres_password@localhost:5432/ptda_staging"

# 3. Khóa bí mật ký mã hóa JWT token (Auth / Owner / Admin)
JWT_SECRET="ptda_homestay_secret_jwt_key_2024_demo_learning_group16"

# 4. Cổng chạy của máy chủ Express Backend (Mặc định: 3000, Render: 10000)
PORT=3000

# 5. Địa chỉ Frontend (CORS whitelist trên Production)
FRONTEND_URL="http://localhost:5173"

# 6. Cấu hình Cloud Storage (Local hoặc Supabase)
# Môi trường Local: 'local' (lưu vào backend/uploads) hoặc 'supabase'
# Môi trường Production (Render): Bắt buộc 'supabase'
STORAGE_DRIVER="local"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 7. Cấu hình Background Storage Cleanup Worker (Tùy chọn)
STORAGE_CLEANUP_WORKER_ENABLED=true
STORAGE_CLEANUP_BATCH_SIZE=10
STORAGE_CLEANUP_POLL_INTERVAL_MS=10000
STORAGE_CLEANUP_SHUTDOWN_TIMEOUT_MS=20000
