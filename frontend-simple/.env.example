# ==============================================================================
# BIẾN MÔI TRƯỜNG FRONTEND (React + Vite)
# Hướng dẫn: Sao chép file này thành .env hoặc .env.local nếu cần cấu hình riêng.
# ==============================================================================

# 1. URL máy chủ Backend API (Local: http://localhost:3000, Production Render: https://ptda-homestay-backend.onrender.com)
VITE_API_URL="http://localhost:3000"
# (Tùy chọn tương thích ngược)
VITE_API_BASE_URL="http://localhost:3000"

# 2. URL Supabase Storage (Tùy chọn - Dùng để tải ảnh trực tiếp từ CDN Supabase)
VITE_SUPABASE_URL="https://your-project.supabase.co"
